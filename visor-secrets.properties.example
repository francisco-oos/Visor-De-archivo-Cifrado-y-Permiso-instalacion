# Copia este archivo como visor-secrets.properties en la raíz del proyecto.
# visor-secrets.properties está ignorado por Git y NO debe subirse.

# Compatibilidad temporal VSDOC1/VSDOC2.
# tools/document_encryptor.py rellena estos dos valores automáticamente.
DOCUMENT_KEY_B64=
DOCUMENT_KEY_SHA256=

# Clave PUBLICA X.509/DER en Base64 para verificar VISOR_LICENSE_V2 (ECDSA P-256).
# No es un secreto y en el futuro puede quedar versionada si se desea.
LICENSE_VERIFY_PUBLIC_KEY_B64=

# Telegram directo: únicamente para desarrollo/debug temporal.
# Mantener false salvo una prueba deliberada.
TELEGRAM_DIRECT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Sólo compatibilidad VISOR_LICENSE_V1 en build debug.
# Release ignora este valor por diseño.
LEGACY_LICENSE_HMAC_SECRET=
